{
  "name": "@freespace8/dsh-free-vision",
  "version": "0.1.0",
  "description": "Local image understanding for the DeepSeek Harness: OCR, table-layout detection, and semantic description of textless images via macOS Vision, fully on-device (images never leave your Mac). 本地化识图，图片不出本机。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "author": "freespace8",
  "homepage": "https://github.com/freespace8/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/freespace8/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vision",
    "ocr",
    "macos",
    "local",
    "privacy",
    "image-understanding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freespace8/dsh-plugins.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "check": "node tests/check.mjs && node tests/unit.mjs"
  }
}
